/* 沿用 app.wxss 中定义的深色主题变量 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* ---------- Tab ---------- */

.tabs {
  display: flex;
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--border);
  background: var(--surface);
}

.tab {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--muted);
  position: relative;
}

.tab.active {
  color: var(--accent);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 60rpx;
  height: 4rpx;
  margin-left: -30rpx;
  background: var(--accent);
  border-radius: 2rpx;
}

/* ---------- 正文 ---------- */

.content {
  flex: 1;
  padding: 40rpx 40rpx 0;
  box-sizing: border-box;
}

.updated {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 40rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fg);
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.para {
  font-size: 26rpx;
  color: #a3a3a3;
  line-height: 1.9;
  margin-bottom: 16rpx;
}

.tail {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  margin: 60rpx 0 0;
}

.bottom-space {
  height: 80rpx;
}

/* ---------- 底部同意按钮 ---------- */

.footer {
  flex-shrink: 0;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--border);
}

.btn-agree {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #052e16;
  background: var(--accent);
  border-radius: 16rpx;
  border: none;
}

.btn-agree::after {
  border: none;
}

.btn-agree:active {
  opacity: 0.85;
}
