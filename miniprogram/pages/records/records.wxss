.container {
  min-height: 100vh;
  padding: 40rpx 28rpx;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

/* Today Summary Entry (unchanged) */
.daily-entry {
  padding: 28rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-left: 6rpx solid #00ff66;
  box-shadow: 0 0 28rpx rgba(34, 197, 94, 0.08);
}

.daily-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.daily-label {
  font-size: 20rpx;
  color: var(--accent);
  letter-spacing: 0.08em;
}

.daily-title {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.daily-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.daily-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 700;
}

.daily-arrow {
  font-size: 28rpx;
  color: var(--muted);
}

/* Empty */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--muted);
}

.empty-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

/* ================================================================
 * Daily Table
 * ================================================================ */

.day-block {
  margin-bottom: 16rpx;
}

.day-row {
  padding: 28rpx;
}

.day-row-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.day-date-col {
  min-width: 100rpx;
  display: flex;
  flex-direction: column;
}

.day-date {
  font-size: 28rpx;
  font-weight: 700;
  color: #f4f4f5;
}

.day-actions-count {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.day-metrics {
  flex: 1;
  display: flex;
  gap: 24rpx;
}

.day-metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 80rpx;
}

.dm-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #00ff66;
}

.dm-max {
  font-size: 26rpx;
  color: #f4f4f5;
}

.dm-label {
  font-size: 18rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

.day-expand-arrow {
  padding-left: 8rpx;
}

.expand-icon {
  font-size: 24rpx;
  color: var(--muted);
  transition: transform 0.2s;
  display: inline-block;
}

.expand-icon-open {
  transform: rotate(180deg);
  color: #00ff66;
}

/* Expanded Detail */
.day-detail {
  margin-top: 2rpx;
  padding: 16rpx 28rpx 20rpx;
  background: rgba(255, 255, 255, 0.02);
  border-bottom: 1rpx solid rgba(0, 255, 102, 0.15);
}

.exercise-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(63, 63, 70, 0.3);
}

.exercise-detail-row:last-child {
  border-bottom: none;
}

.edr-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.edr-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.edr-exercise {
  font-size: 26rpx;
  font-weight: 600;
  color: #f4f4f5;
}

.edr-category {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

.pr-badge {
  font-size: 18rpx;
  font-weight: 800;
  color: #0a0a0a;
  background: #00ff66;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  letter-spacing: 0.05em;
}

.edr-stats {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}

.edr-stat {
  font-size: 22rpx;
  color: rgba(244, 244, 245, 0.65);
  white-space: nowrap;
}

.edr-max {
  color: #00ff66;
  font-weight: 600;
}
