<view class="container">
  <view class="header">
    <text class="title">每日复盘</text>
    <text class="subtitle">{{recordDays.length}} 个训练日</text>
  </view>

  <!-- Today Summary Entry -->
  <view wx:if="{{hasTodaySummary}}" class="daily-entry surface-elevated" bindtap="onOpenTodaySummary">
    <view class="daily-copy">
      <text class="daily-label">今日总结</text>
      <text class="daily-title">{{todaySummary.exerciseCount}} 个动作 · {{todaySummary.totalSets}} 组</text>
      <text class="daily-meta">{{todaySummary.totalVolume}} kg · {{todaySummary.totalDurationMinutes}} 分钟</text>
    </view>
    <view class="daily-action">
      <text>查看今日卡</text>
      <text class="daily-arrow">→</text>
    </view>
  </view>

  <!-- Empty State -->
  <view wx:if="{{recordDays.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">还没有训练记录</text>
    <text class="empty-desc">完成一次训练后，记录会出现在这里</text>
  </view>

  <!-- Daily Table -->
  <view wx:for="{{recordDays}}" wx:key="dateKey" class="day-block">
    <view
      class="day-row surface-elevated"
      data-datekey="{{item.dateKey}}"
      bindtap="onToggleDay"
    >
      <view class="day-row-main">
        <view class="day-date-col">
          <text class="day-date">{{item.dateLabel}}</text>
          <text class="day-actions-count">{{item.exerciseCount}} 个动作</text>
        </view>
        <view class="day-metrics">
          <view class="day-metric">
            <text class="dm-val">{{item.totalSets}}</text>
            <text class="dm-label">组</text>
          </view>
          <view class="day-metric">
            <text class="dm-val">{{item.totalVolume}}</text>
            <text class="dm-label">kg</text>
          </view>
          <view class="day-metric">
            <text class="dm-val">{{item.totalDurationMinutes}}</text>
            <text class="dm-label">分钟</text>
          </view>
          <view class="day-metric">
            <text class="dm-val dm-max">{{item.maxWeight}}</text>
            <text class="dm-label">MAX kg</text>
          </view>
        </view>
        <view class="day-expand-arrow">
          <text class="expand-icon {{expandedDateKey === item.dateKey ? 'expand-icon-open' : ''}}">▾</text>
        </view>
      </view>
    </view>

    <!-- Expanded Exercise Details -->
    <view wx:if="{{expandedDateKey === item.dateKey}}" class="day-detail">
      <view
        wx:for="{{item.exerciseRows}}"
        wx:key="exerciseName"
        wx:for-item="row"
        class="exercise-detail-row"
      >
        <view class="edr-left">
          <view class="edr-name-row">
            <text class="edr-exercise">{{row.exerciseName}}</text>
            <text wx:if="{{row.isWeightPr}}" class="pr-badge">PR</text>
          </view>
          <text class="edr-category">{{row.categoryName}}</text>
        </view>
        <view class="edr-stats">
          <text class="edr-stat">{{row.sets}} 组</text>
          <text class="edr-stat">{{row.volume}} kg</text>
          <text class="edr-stat edr-max">{{row.maxWeight}} kg</text>
        </view>
      </view>
    </view>
  </view>
</view>
