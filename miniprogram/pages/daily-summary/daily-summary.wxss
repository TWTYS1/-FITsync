.container {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  background: #0a0a0a;
  box-sizing: border-box;
}

.summary-shell {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.carbon-card {
  width: 100%;
  max-width: 680rpx;
  min-height: 850rpx;
  box-sizing: border-box;
  padding: 48rpx;
  border: 1rpx solid #27272a;
  background: #09090b;
  color: #d4d4d8;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.card-header,
.card-footer {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.session-block,
.date-block,
.footer-copy,
.brand,
.metric,
.featured-copy {
  display: flex;
  flex-direction: column;
}

.date-block,
.brand {
  align-items: flex-end;
  text-align: right;
}

.session-label,
.date-text,
.weekday-text,
.metric-label,
.activity-label,
.featured-data,
.featured-subs,
.detail-subs,
.footer-copy {
  font-family: Menlo, Monaco, Consolas, monospace;
  letter-spacing: 0.12em;
}

.session-label,
.date-text {
  font-size: 22rpx;
  color: rgba(212, 212, 216, 0.62);
}

.focus-text {
  margin-top: 10rpx;
  font-size: 34rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #f4f4f5;
}

.weekday-text {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: rgba(212, 212, 216, 0.38);
}

.accent {
  color: #00ff66;
}

/* ========== Metrics ========== */

.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 44rpx 28rpx;
}

.metric-header-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.metric-label {
  margin-bottom: 8rpx;
  font-size: 18rpx;
  color: rgba(212, 212, 216, 0.48);
}

.metric-header-row .metric-label {
  margin-bottom: 0;
}

.pr-chip {
  display: inline-block;
  padding: 2rpx 10rpx;
  font-size: 16rpx;
  font-weight: 900;
  color: #07130b;
  background: #00ff66;
  border-radius: 4rpx;
  letter-spacing: 0.08em;
}

.metric-value {
  font-size: 64rpx;
  line-height: 0.95;
  font-weight: 900;
  letter-spacing: 0;
  color: #f4f4f5;
}

.empty-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 56rpx 0;
}

.empty-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #00ff66;
}

.empty-desc {
  font-size: 24rpx;
  color: rgba(212, 212, 216, 0.5);
}

.activity-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.activity-label {
  font-size: 16rpx;
  color: rgba(212, 212, 216, 0.42);
}

.activity-grid {
  display: flex;
  gap: 6rpx;
  width: 100%;
}

.activity-cell {
  flex: 1;
  height: 18rpx;
  border-radius: 2rpx;
  background: rgba(63, 63, 70, 0.55);
}

.activity-cell-active {
  background: #00ff66;
  box-shadow: 0 0 12rpx rgba(0, 255, 102, 0.45);
}

/* ========== Featured ========== */

.featured-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.featured-label {
  font-size: 16rpx;
  color: rgba(212, 212, 216, 0.42);
  font-family: Menlo, Monaco, Consolas, monospace;
  letter-spacing: 0.12em;
}

.featured-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(63, 63, 70, 0.45);
}

.featured-name {
  max-width: 260rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #f4f4f5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.featured-category {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: rgba(212, 212, 216, 0.42);
}

.featured-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding-top: 4rpx;
}

.more-dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: rgba(0, 255, 102, 0.55);
  box-shadow: 0 0 10rpx rgba(0, 255, 102, 0.22);
}

/* ========== Row stats ========== */

.row-stats {
  flex-shrink: 0;
  display: grid;
  grid-template-columns: 36rpx 112rpx minmax(34rpx, auto);
  align-items: center;
  justify-items: end;
  column-gap: 12rpx;
  font-family: Menlo, Monaco, Consolas, monospace;
}

.row-set-count,
.row-weight {
  line-height: 1;
  font-weight: 900;
  letter-spacing: 0;
  color: #f4f4f5;
}

.row-set-count {
  justify-self: start;
  font-size: 24rpx;
  color: rgba(244, 244, 245, 0.72);
}

.row-weight {
  font-size: 24rpx;
}

.pr-chip-edge {
  display: inline-block;
  padding: 2rpx 8rpx;
  font-size: 14rpx;
  font-weight: 900;
  color: #07130b;
  background: #00ff66;
  border-radius: 4rpx;
  letter-spacing: 0.08em;
  flex-shrink: 0;
}

/* ========== Details ========== */

.details-section {
  width: 100%;
  max-width: 680rpx;
  margin-top: 48rpx;
  padding: 40rpx;
  box-sizing: border-box;
  border: 1rpx solid #27272a;
  background: #09090b;
}

.details-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(63, 63, 70, 0.55);
}

.details-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #f4f4f5;
  font-family: Menlo, Monaco, Consolas, monospace;
  letter-spacing: 0.08em;
}

.details-date {
  font-size: 20rpx;
  color: rgba(212, 212, 216, 0.42);
  font-family: Menlo, Monaco, Consolas, monospace;
  letter-spacing: 0.08em;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(63, 63, 70, 0.3);
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-copy {
  display: flex;
  flex-direction: column;
}

.detail-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #f4f4f5;
}

.detail-category {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(212, 212, 216, 0.4);
}

.detail-stats {
  grid-template-columns: 38rpx 122rpx minmax(34rpx, auto);
}

.detail-empty {
  text-align: center;
  padding: 32rpx 0;
  font-size: 22rpx;
  color: rgba(212, 212, 216, 0.35);
}

/* ========== Footer ========== */

.footer-copy {
  gap: 2rpx;
  font-size: 16rpx;
  color: rgba(212, 212, 216, 0.45);
}

.brand-mark {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  border: 1rpx solid rgba(0, 255, 102, 0.7);
  color: #00ff66;
  text-align: center;
  font-size: 18rpx;
  font-weight: 900;
}

.brand-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: rgba(244, 244, 245, 0.7);
}

.hint-row {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: rgba(212, 212, 216, 0.46);
}

.back-btn {
  margin-top: 40rpx;
  height: 88rpx;
  border-radius: 14rpx;
  background: #00ff66;
  color: #07130b;
  font-size: 28rpx;
  font-weight: 800;
}

.back-btn::after {
  border: 0;
}
