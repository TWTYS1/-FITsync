<view class="container">
  <view class="summary-shell">
    <view class="carbon-card">
      <view class="card-header">
        <view class="session-block">
          <text class="session-label">DAY.<text class="accent">{{dayNumberText}}</text></text>
          <text class="focus-text">{{focusText}}</text>
        </view>
        <view class="date-block">
          <text class="date-text">{{summary.date}}</text>
          <text class="weekday-text">{{summary.weekday}}</text>
        </view>
      </view>

      <view wx:if="{{hasRecords}}" class="metrics-grid">
        <view class="metric metric-primary">
          <text class="metric-label">今日最重</text>
          <text class="metric-value accent">{{summaryMaxWeightLabel}}</text>
        </view>
        <view class="metric">
          <text class="metric-label">动作</text>
          <text class="metric-value">{{summary.exerciseCount}}</text>
        </view>
        <view class="metric">
          <text class="metric-label">时长</text>
          <text class="metric-value">{{summary.totalDurationMinutes}}</text>
        </view>
        <view class="metric">
          <text class="metric-label">正式组</text>
          <text class="metric-value">{{summary.totalSets}}</text>
        </view>
      </view>

      <view wx:else class="empty-card">
        <text class="empty-title">NO TRAINING</text>
        <text class="empty-desc">今天还没有训练记录</text>
      </view>

      <view class="activity-section">
        <text class="activity-label">ACTIVITY (LAST 28 DAYS)</text>
        <view class="activity-grid">
          <view
            wx:for="{{summary.historyGrid28Days}}"
            wx:key="dateKey"
            class="activity-cell {{item.active ? 'activity-cell-active' : ''}}"
          ></view>
        </view>
      </view>

      <view wx:if="{{hasRecords}}" class="featured-section">
        <text class="featured-label">FEATURED</text>
        <view
          wx:for="{{featuredExercises}}"
          wx:key="name"
          class="featured-row"
        >
          <view class="featured-copy">
            <text class="featured-name">{{item.name}}</text>
            <text class="featured-category">{{item.categoryName}}</text>
          </view>
          <view class="row-stats">
            <text class="row-set-count">{{item.sets}}</text>
            <text class="row-weight">{{item.maxWeightLabel}}</text>
            <text wx:if="{{item.isWeightPr}}" class="pr-chip-edge">PR</text>
          </view>
        </view>
        <view wx:if="{{hasMoreFeaturedExercises}}" class="featured-more">
          <view class="more-dot"></view>
          <view class="more-dot"></view>
          <view class="more-dot"></view>
        </view>
      </view>

      <view class="card-footer">
        <view class="footer-copy">
          <text>QUIET WORK</text>
          <text>COUNTS TOO</text>
        </view>
        <view class="brand">
          <text class="brand-mark">FS</text>
          <text class="brand-text">FitSync</text>
        </view>
      </view>
    </view>

    <view class="hint-row">
      <text>截图保存这张今日训练卡</text>
    </view>

    <view wx:if="{{hasRecords}}" class="details-section">
      <view class="details-header">
        <text class="details-title">今日明细</text>
        <text class="details-date">{{summary.date}} {{summary.weekday}}</text>
      </view>
      <view
        wx:for="{{detailRows}}"
        wx:key="exerciseName"
        class="detail-row"
      >
        <view class="detail-copy">
          <text class="detail-name">{{item.exerciseName}}</text>
          <text class="detail-category">{{item.categoryName}}</text>
        </view>
        <view class="row-stats detail-stats">
          <text class="row-set-count">{{item.sets}}</text>
          <text class="row-weight">{{item.maxWeightLabel}}</text>
          <text wx:if="{{item.isWeightPr}}" class="pr-chip-edge">PR</text>
        </view>
      </view>
      <view wx:if="{{detailRows.length === 0}}" class="detail-empty">
        <text>暂无明细</text>
      </view>
    </view>
  </view>

  <button class="back-btn" bindtap="onBack">返回</button>
</view>
