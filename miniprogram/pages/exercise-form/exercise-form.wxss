.container {
  min-height: 100vh;
  padding: 40rpx 28rpx 80rpx;
  background: var(--bg);
}

.header {
  margin-bottom: 48rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

/* Form */
.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--fg);
}

.input-placeholder {
  color: var(--muted);
}

/* Chips */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 16rpx 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.chip-active {
  background: rgba(34, 197, 94, 0.12);
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 600;
}

/* Steppers */
.stepper-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.step-btn {
  padding: 16rpx 32rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--fg);
}

.step-plus {
  background: var(--accent);
  border-color: var(--accent);
  color: #0a0a0a;
}

.step-val {
  font-size: 36rpx;
  font-weight: 700;
  min-width: 80rpx;
  text-align: center;
}

.step-input {
  width: 128rpx;
  height: 72rpx;
  text-align: center;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  color: var(--fg);
  font-size: 32rpx;
  font-weight: 700;
}

.step-input-reps {
  width: 96rpx;
}

.step-input-sets {
  width: 96rpx;
}

/* Actions */
.actions {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-save {
  width: 100%;
  height: 96rpx;
  background: var(--accent);
  color: #0a0a0a;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 20rpx;
  border: none;
}

.btn-save::after {
  border: none;
}

.btn-delete {
  width: 100%;
  height: 96rpx;
  background: transparent;
  border: 2rpx solid var(--danger);
  color: var(--danger);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
}

.btn-delete::after {
  border: none;
}
