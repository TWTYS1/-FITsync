<view class="container">
  <!-- ==================== State: Exercises ==================== -->
  <view wx:if="{{state === 'exercises'}}" class="exercises-view">
    <!-- Horizontal Category Tabs -->
    <scroll-view class="category-tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-tabs-inner">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="category-tab {{activeCategory === item.key ? 'category-tab-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onTapCategoryTab"
        >
          <text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- Today Training Strip -->
    <view class="today-card surface-elevated {{hasTodaySummary ? 'today-card-active' : ''}}" bindtap="onOpenTodaySummary">
      <view class="today-copy">
        <text class="today-label">今日训练</text>
        <text wx:if="{{hasTodaySummary}}" class="today-title">{{todaySummary.exerciseCount}} 个动作 · {{todaySummary.totalSets}} 组</text>
        <text wx:else class="today-title">还没有记录</text>
        <text wx:if="{{hasTodaySummary}}" class="today-meta">{{todaySummary.totalVolume}} kg · {{todaySummary.totalDurationMinutes}} 分钟</text>
        <text wx:else class="today-meta">训练结束后会生成今日总结</text>
      </view>
      <view class="today-action">
        <text wx:if="{{hasTodaySummary}}" class="today-action-text">查看今日总结</text>
        <text wx:else class="today-action-text muted">待生成</text>
        <text class="today-arrow">→</text>
      </view>
    </view>

    <!-- Frequent Exercises -->
    <view wx:if="{{frequentExercises.length > 0}}" class="section">
      <text class="section-label">常用</text>
      <view class="exercise-list">
        <view
          wx:for="{{frequentExercises}}"
          wx:key="id"
          class="exercise-card surface-elevated exercise-frequent"
          data-id="{{item.id}}"
          bindtap="onTapFrequent"
        >
          <view class="exercise-info">
            <view class="exercise-name-row">
              <text class="exercise-name">{{item.name}}</text>
              <text wx:if="{{item.source === 'custom'}}" class="custom-tag">自定义</text>
            </view>
            <text class="exercise-meta">{{item.targetSets}} 组 · {{item.defaultWeight}}kg · {{item.defaultReps}} 次</text>
            <text
              wx:if="{{item.source === 'custom'}}"
              class="manage-link"
              data-id="{{item.id}}"
              catchtap="onEditCustomExercise"
            >管理</text>
          </view>
          <view class="exercise-right">
            <text class="exercise-role role-{{item.role}}">{{item.roleName}}</text>
            <text class="exercise-arrow">→</text>
          </view>
        </view>
      </view>
    </view>

    <!-- All Exercises by Role -->
    <view class="section">
      <view wx:for="{{exercises}}" wx:key="id" wx:for-item="ex">
        <!-- Role header when role changes -->
        <text wx:if="{{ex.showRoleHeader}}" class="role-header">{{ex.roleName}}</text>

        <view
          class="exercise-card surface-elevated"
          data-id="{{ex.id}}"
          bindtap="onTapExercise"
        >
          <view class="exercise-info">
            <view class="exercise-name-row">
              <text class="exercise-name">{{ex.name}}</text>
              <text wx:if="{{ex.source === 'custom'}}" class="custom-tag">自定义</text>
            </view>
            <text class="exercise-meta">{{ex.targetSets}} 组 · {{ex.defaultWeight}}kg · {{ex.defaultReps}} 次</text>
            <text
              wx:if="{{ex.source === 'custom'}}"
              class="manage-link"
              data-id="{{ex.id}}"
              catchtap="onEditCustomExercise"
            >管理</text>
          </view>
          <view class="exercise-right">
            <text class="exercise-role role-{{ex.role}}">{{ex.roleName}}</text>
            <text class="exercise-arrow">→</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Add Custom Exercise -->
    <view class="custom-action">
      <view class="custom-btn" bindtap="onAddCustomExercise">
        <text class="custom-btn-icon">+</text>
        <text>自定义动作</text>
      </view>
    </view>
  </view>

  <!-- ==================== State: Training ==================== -->
  <view wx:if="{{state === 'training'}}" class="training-view">
    <view class="training-header">
      <text class="training-exercise">{{session.exerciseName}}</text>
      <text class="training-set-count">第 {{session.currentSet}} / {{session.targetSets}} 组</text>
    </view>

    <!-- Set Dots -->
    <view class="set-dots">
      <view
        wx:for="{{setDots}}"
        wx:key="index"
        class="dot {{item.done ? 'dot-done' : ''}} {{item.current ? 'dot-current' : ''}}"
      ></view>
    </view>

    <!-- Last Set Panel -->
    <view wx:if="{{latestSet}}" class="last-set-panel">
      <view class="last-set-trigger" bindtap="toggleLastSetPanel">
        <text class="last-trigger-label">{{latestSetLabel}}</text>
        <text class="last-trigger-data">{{latestSet.weight}} kg × {{latestSet.reps}} 次</text>
        <text wx:if="{{latestSetTimeText}}" class="last-trigger-time">{{latestSetTimeText}}</text>
        <text class="last-trigger-arrow {{lastSetPanelExpanded ? 'expanded' : ''}}">▾</text>
      </view>
      <view wx:if="{{lastSetPanelExpanded}}" class="last-set-detail">
        <text class="last-detail-line">完成时间：{{latestSetTimeText}}</text>
        <text class="last-detail-line">正式组进度：{{completedFormalSetCount}} / {{session.targetSets}}</text>
      </view>
    </view>

    <!-- Missed Set Prompt -->
    <view wx:if="{{missedSetPrompt}}" class="missed-prompt">
      <text class="missed-title">是不是漏记了一组？</text>
      <text class="missed-desc">如果刚刚练完，可以直接补记。</text>
      <view class="missed-actions">
        <button class="missed-btn missed-primary" bindtap="onMissedSetRecord">补记一组</button>
        <button class="missed-btn" bindtap="onMissedSetIgnore">忽略</button>
      </view>
    </view>

    <!-- Big + Button -->
    <view class="add-btn-wrapper">
      <view class="add-btn" bindtap="onOpenSheet">
        <text class="add-btn-text">+</text>
      </view>
      <text class="add-btn-label">练完了，记一组</text>
      <text class="add-btn-sub">第 {{session.currentSet}} / {{session.targetSets}} 组</text>
    </view>
  </view>

  <!-- ==================== State: Resting ==================== -->
  <view wx:if="{{state === 'resting'}}" class="resting-view">
    <view class="rest-header">
      <text class="rest-exercise">{{session.exerciseName}}</text>
      <text class="rest-set-done">第 {{session.currentSet - 1}} 组完成</text>
    </view>

    <!-- Circular Timer -->
    <view class="rest-timer-circle">
      <view class="timer-ring">
        <view class="timer-progress" style="background: conic-gradient(var(--accent) {{restProgressDeg}}deg, transparent 0deg);">
          <view class="timer-inner">
            <text class="timer-seconds">{{restSeconds}}</text>
            <text class="timer-unit">秒</text>
          </view>
        </view>
      </view>
    </view>

    <view class="rest-last-set">
      <text class="rest-set-weight">{{latestSet.weight}} kg</text>
      <text class="rest-set-reps">{{latestSet.reps}} 次</text>
      <text wx:if="{{latestSet.isWarmup}}" class="warmup-tag">热身组</text>
    </view>

    <view class="rest-next">
      <text>下一组：第 {{session.currentSet}} 组，{{session.lastWeight}} kg × {{session.lastReps}} 次</text>
    </view>

    <view class="rest-actions">
      <button class="btn-skip-rest" bindtap="onSkipRest">跳过休息</button>
    </view>
  </view>

  <!-- ==================== State: Summary ==================== -->
  <view wx:if="{{state === 'summary'}}" class="summary-view">
    <view class="summary-icon">✓</view>
    <text class="summary-title">训练完成</text>
    <text class="summary-exercise">{{summary.exerciseName}}</text>

    <view class="summary-stats">
      <view class="summary-stat">
        <text class="s-val">{{summary.totalSets}}</text>
        <text class="s-label">完成组数</text>
      </view>
      <view class="summary-stat">
        <text class="s-val">{{summary.totalVolume}}</text>
        <text class="s-label">总训练量 (kg)</text>
      </view>
    </view>

    <!-- Set Details -->
    <view class="summary-sets">
      <text class="summary-sets-title">每组明细</text>
      <view
        wx:for="{{summary.sets}}"
        wx:key="setNumber"
        wx:for-item="s"
        class="summary-set-row"
      >
        <text class="ss-num">{{s.setLabel}}</text>
        <text class="ss-data">{{s.weight}} kg × {{s.reps}} 次</text>
        <text wx:if="{{s.isWarmup}}" class="ss-warmup">热身</text>
      </view>
    </view>

    <view class="summary-actions">
      <button class="btn-finish btn-secondary" bindtap="onContinueAfterSummary">继续练下一个动作</button>
      <button class="btn-finish" bindtap="onOpenTodaySummary">查看今日总结</button>
    </view>
  </view>

  <!-- ==================== Start Settings Sheet ==================== -->
  <view wx:if="{{showStartSheet}}" class="sheet-overlay" bindtap="onCloseStartSheet"></view>
  <view class="sheet {{showStartSheet ? 'sheet-open' : ''}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">{{startExercise.name}}</text>
    <text wx:if="{{startExercise.source === 'custom'}}" class="sheet-custom-label">自定义动作</text>

    <view class="sheet-row">
      <text class="sheet-label">目标组数</text>
      <view class="sheet-stepper">
        <view class="step-btn" bindtap="onStartSetsMinus">− 1</view>
        <input
          class="step-input step-input-sets"
          type="number"
          value="{{startTargetSetsText}}"
          bindinput="onStartSetsInput"
          bindblur="onStartSetsBlur"
          confirm-type="done"
        />
        <view class="step-btn step-plus" bindtap="onStartSetsPlus">+ 1</view>
      </view>
    </view>

    <view class="sheet-row">
      <text class="sheet-label">默认重量 (kg)</text>
      <view class="sheet-stepper">
        <view class="step-btn" bindtap="onStartWeightMinus">− 2.5</view>
        <input
          class="step-input"
          type="digit"
          value="{{startDefaultWeightText}}"
          bindinput="onStartWeightInput"
          bindblur="onStartWeightBlur"
          confirm-type="done"
        />
        <view class="step-btn step-plus" bindtap="onStartWeightPlus">+ 2.5</view>
      </view>
    </view>

    <view class="sheet-row">
      <text class="sheet-label">默认次数</text>
      <view class="sheet-stepper">
        <view class="step-btn" bindtap="onStartRepsMinus">− 1</view>
        <input
          class="step-input step-input-reps"
          type="number"
          value="{{startDefaultRepsText}}"
          bindinput="onStartRepsInput"
          bindblur="onStartRepsBlur"
          confirm-type="done"
        />
        <view class="step-btn step-plus" bindtap="onStartRepsPlus">+ 1</view>
      </view>
    </view>

    <view class="sheet-row">
      <text class="sheet-label">休息时间</text>
      <view class="rest-options">
        <view
          wx:for="{{restDurationOptions}}"
          wx:key="*this"
          class="rest-option {{startRestDurationSeconds === item ? 'rest-option-active' : ''}}"
          data-seconds="{{item}}"
          bindtap="onSelectRestOption"
        >
          <text>{{item}}s</text>
        </view>
      </view>
    </view>

    <view class="sheet-row">
      <text class="sheet-label">保存为我的默认值</text>
      <switch
        checked="{{saveAsDefault}}"
        bindchange="onToggleSaveAsDefault"
        color="#22c55e"
      />
    </view>

    <button class="btn-confirm" bindtap="onStartTraining">开始训练</button>
  </view>

  <!-- ==================== Set Confirm Sheet ==================== -->
  <view wx:if="{{showSheet}}" class="sheet-overlay" bindtap="onCloseSheet"></view>
  <view class="sheet {{showSheet ? 'sheet-open' : ''}}">
    <view class="sheet-handle"></view>
    <text class="sheet-title">第 {{session.currentSet}} 组</text>

    <view class="sheet-row">
      <text class="sheet-label">重量 (kg)</text>
      <view class="sheet-stepper">
        <view class="step-btn" bindtap="onSheetWeightMinus">− 2.5</view>
        <input
          class="step-input"
          type="digit"
          value="{{sheetWeightText}}"
          bindinput="onSheetWeightInput"
          bindblur="onSheetWeightBlur"
          confirm-type="done"
        />
        <view class="step-btn step-plus" bindtap="onSheetWeightPlus">+ 2.5</view>
      </view>
    </view>

    <view class="sheet-row">
      <text class="sheet-label">次数</text>
      <view class="sheet-stepper">
        <view class="step-btn" bindtap="onSheetRepsMinus">− 1</view>
        <input
          class="step-input step-input-reps"
          type="number"
          value="{{sheetRepsText}}"
          bindinput="onSheetRepsInput"
          bindblur="onSheetRepsBlur"
          confirm-type="done"
        />
        <view class="step-btn step-plus" bindtap="onSheetRepsPlus">+ 1</view>
      </view>
    </view>

    <view class="sheet-row">
      <text class="sheet-label">热身组</text>
      <switch
        checked="{{sheetIsWarmup}}"
        bindchange="onToggleWarmup"
        color="#22c55e"
      />
    </view>

    <!-- Delayed Confirm Button -->
    <view
      class="btn-confirm-wrapper"
      bindtouchstart="onConfirmTouchStart"
      bindtouchend="onConfirmTouchEnd"
      bindtouchcancel="onConfirmTouchEnd"
    >
      <view class="btn-confirm-bar" style="width: {{confirmProgress}}%;"></view>
      <text class="btn-confirm-text">{{confirmHint}}</text>
    </view>
  </view>

  <view wx:if="{{undoToast}}" class="undo-toast floating-toast">
    <view>
      <text class="undo-title">已记录{{undoToast.setLabel}}</text>
      <text class="undo-desc">{{undoToast.seconds}} 秒内可撤销</text>
    </view>
    <button class="undo-action" bindtap="onUndoSet">撤销</button>
  </view>

  <view wx:if="{{restFinishedHint}}" class="rest-finished-hint floating-toast">
    <text>休息结束，准备下一组</text>
  </view>
</view>
