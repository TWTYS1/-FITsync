.container {
  min-height: 100vh;
  background: var(--bg);
}

/* ===== Exercises View ===== */
.exercises-view {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Category Tabs */
.category-tabs {
  flex-shrink: 0;
  background: var(--bg);
  border-bottom: 1rpx solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
}

.category-tabs-inner {
  display: flex;
  padding: 16rpx 16rpx;
  gap: 12rpx;
  white-space: nowrap;
}

.category-tab {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--muted);
  background: var(--surface);
  transition: all 0.15s ease;
}

.category-tab-active {
  background: var(--accent);
  color: #0a0a0a;
  font-weight: 700;
}

.today-card {
  margin: 24rpx 24rpx 8rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-left: 6rpx solid rgba(34, 197, 94, 0.35);
}

.today-card-active {
  border-left-color: #00ff66;
  box-shadow: 0 0 28rpx rgba(34, 197, 94, 0.08);
}

.today-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.today-label {
  font-size: 20rpx;
  color: var(--accent);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.today-title {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--fg);
}

.today-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.today-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.today-action-text {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 700;
}

.today-action-text.muted {
  color: var(--muted);
}

.today-arrow {
  font-size: 28rpx;
  color: var(--muted);
}

/* Sections */
.section {
  padding: 0 24rpx;
  margin-bottom: 8rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
  padding: 24rpx 4rpx 16rpx;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

/* Exercise List */
.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.exercise-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.exercise-frequent {
  border-left: 6rpx solid var(--accent);
}

.exercise-info {
  flex: 1;
  min-width: 0;
}

.exercise-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.exercise-name {
  font-size: 30rpx;
  font-weight: 600;
}

.exercise-meta {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.manage-link {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--accent);
}

.custom-tag {
  font-size: 20rpx;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}

.exercise-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.exercise-role {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.role-warmup {
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.1);
}

.role-main {
  color: #22c55e;
  background: rgba(34, 197, 94, 0.1);
}

.role-accessory {
  color: #3b82f6;
  background: rgba(59, 130, 246, 0.1);
}

.role-isolation {
  color: #a855f7;
  background: rgba(168, 85, 247, 0.1);
}

.exercise-arrow {
  font-size: 28rpx;
  color: var(--muted);
}

/* Role Header */
.role-header-wrapper {
  margin-top: 8rpx;
}

.role-header {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--muted);
  padding: 24rpx 4rpx 12rpx;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Custom Action */
.custom-action {
  padding: 32rpx 24rpx 60rpx;
  flex-shrink: 0;
}

.custom-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 28rpx;
  border: 2rpx dashed var(--border);
  border-radius: 16rpx;
  color: var(--muted);
  font-size: 28rpx;
}

.custom-btn-icon {
  font-size: 36rpx;
  font-weight: 300;
  color: var(--accent);
}

/* ===== Training View ===== */
.training-view {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 28rpx;
}

.training-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.training-exercise {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.training-set-count {
  display: block;
  font-size: 26rpx;
  color: var(--accent);
  margin-top: 8rpx;
}

/* Set Dots */
.set-dots {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--border);
  transition: all 0.2s ease;
}

.dot-done {
  background: var(--accent);
}

.dot-current {
  background: transparent;
  border: 3rpx solid var(--accent);
  width: 26rpx;
  height: 26rpx;
  margin-top: -3rpx;
}

/* Last Set Panel */
.last-set-panel {
  width: 100%;
  margin-bottom: 24rpx;
}

.last-set-trigger {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--surface);
  border-radius: 12rpx;
}

.last-trigger-label {
  font-size: 24rpx;
  color: var(--muted);
}

.last-trigger-data {
  font-size: 28rpx;
  font-weight: 600;
}

.last-trigger-time {
  font-size: 22rpx;
  color: var(--muted);
  margin-left: auto;
}

.last-trigger-arrow {
  font-size: 20rpx;
  color: var(--muted);
  transition: transform 0.2s;
}

.last-trigger-arrow.expanded {
  transform: rotate(180deg);
}

.last-set-detail {
  padding: 16rpx 24rpx;
  background: var(--surface);
  border-radius: 0 0 12rpx 12rpx;
  border-top: 1rpx solid var(--border);
}

.last-detail-line {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.8;
}

/* Undo Toast */
.undo-toast {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 22rpx;
  background: var(--surface-elevated);
  border: 1rpx solid rgba(239, 68, 68, 0.62);
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 14rpx 42rpx rgba(239, 68, 68, 0.12);
}

.floating-toast {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  top: calc(28rpx + env(safe-area-inset-top));
  z-index: 120;
  width: auto;
}

.undo-title {
  display: block;
  font-size: 26rpx;
  color: var(--fg);
  font-weight: 700;
}

.undo-desc {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.undo-action {
  margin: 0;
  flex-shrink: 0;
  min-width: 112rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: rgba(239, 68, 68, 0.1);
  border: 1rpx solid rgba(239, 68, 68, 0.52);
  color: #f87171;
  font-size: 24rpx;
  font-weight: 800;
}

.undo-action::after {
  border: none;
}

/* Missed Set Prompt */
.missed-prompt {
  width: 100%;
  margin-bottom: 24rpx;
  padding: 22rpx;
  background: var(--surface);
  border: 1rpx solid rgba(34, 197, 94, 0.35);
  border-radius: 16rpx;
}

.missed-title {
  display: block;
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 800;
}

.missed-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.missed-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.missed-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0;
  border-radius: 14rpx;
  background: var(--surface-elevated);
  color: var(--fg);
  font-size: 24rpx;
}

.missed-primary {
  background: var(--accent);
  color: #0a0a0a;
  font-weight: 800;
}

.missed-btn::after {
  border: none;
}

/* Big + Button */
.add-btn-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: auto;
  margin-bottom: 80rpx;
  min-width: 240rpx;
}

.add-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 42rpx rgba(34, 197, 94, 0.38);
  transition: transform 0.12s ease, filter 0.12s ease, box-shadow 0.12s ease;
  animation: addPulse 2.8s ease-in-out infinite;
}

.add-btn:active {
  transform: scale(0.94);
  filter: brightness(1.08);
  box-shadow: 0 6rpx 24rpx rgba(34, 197, 94, 0.48);
  animation-play-state: paused;
}

.add-btn-text {
  font-size: 96rpx;
  color: #0a0a0a;
  font-weight: 300;
  line-height: 1;
}

.add-btn-label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 20rpx;
}

.add-btn-sub {
  display: block;
  font-size: 22rpx;
  color: var(--accent);
  margin-top: 6rpx;
}

@keyframes addPulse {
  0%,
  100% {
    box-shadow: 0 12rpx 42rpx rgba(34, 197, 94, 0.34);
  }

  50% {
    box-shadow:
      0 14rpx 52rpx rgba(34, 197, 94, 0.46),
      0 0 0 16rpx rgba(34, 197, 94, 0.08);
  }
}

/* ===== Resting ===== */
.resting-view {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 28rpx;
}

.rest-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.rest-exercise {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.rest-set-done {
  display: block;
  font-size: 26rpx;
  color: var(--accent);
  margin-top: 8rpx;
}

.rest-timer-circle {
  margin-bottom: 48rpx;
}

.timer-ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  padding: 10rpx;
  background: var(--border);
}

.timer-progress {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.timer-inner {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.timer-seconds {
  font-size: 80rpx;
  font-weight: 800;
  color: var(--accent);
}

.timer-unit {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.rest-last-set {
  text-align: center;
  margin-bottom: 20rpx;
}

.rest-set-weight {
  font-size: 40rpx;
  font-weight: 700;
}

.rest-set-reps {
  display: block;
  font-size: 28rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.warmup-tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  margin-top: 8rpx;
}

.rest-finished-hint {
  padding: 12rpx 32rpx;
  background: rgba(34, 197, 94, 0.1);
  border: 1rpx solid rgba(34, 197, 94, 0.35);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--accent);
  text-align: center;
}

.rest-next {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 48rpx;
}

.rest-actions {
  margin-top: auto;
  margin-bottom: 40rpx;
}

.btn-skip-rest {
  background: transparent;
  border: 2rpx solid var(--border);
  color: var(--fg);
  font-size: 28rpx;
  padding: 24rpx 80rpx;
  border-radius: 20rpx;
}

.btn-skip-rest::after {
  border: none;
}

/* ===== Summary ===== */
.summary-view {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 28rpx 60rpx;
}

.summary-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #0a0a0a;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.summary-title {
  font-size: 48rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.summary-exercise {
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 48rpx;
}

.summary-stats {
  display: flex;
  gap: 60rpx;
  margin-bottom: 48rpx;
}

.summary-stat {
  text-align: center;
}

.s-val {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--accent);
}

.s-label {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.summary-sets {
  width: 100%;
  margin-bottom: 60rpx;
}

.summary-sets-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.summary-set-row {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: var(--surface);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.ss-num {
  font-size: 26rpx;
  color: var(--muted);
  width: 120rpx;
}

.ss-data {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
}

.ss-warmup {
  font-size: 20rpx;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.btn-finish {
  width: 100%;
  height: 96rpx;
  background: var(--accent);
  color: #0a0a0a;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 20rpx;
  border: none;
}

.btn-finish::after {
  border: none;
}

.summary-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.summary-actions .btn-finish {
  margin-top: 0;
}

.btn-secondary {
  background: var(--surface-elevated);
  color: var(--fg);
  border: 1rpx solid var(--border);
}

/* ===== Bottom Sheets ===== */
.sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface-elevated);
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 28rpx 48rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  /* 安全区:基础 48rpx + 底部安全区(刘海屏/Home条),无安全区机型回落为 48rpx */
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.sheet-open {
  transform: translateY(0);
}

.sheet-handle {
  width: 56rpx;
  height: 6rpx;
  background: var(--border);
  border-radius: 3rpx;
  margin: 0 auto 32rpx;
}

.sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 36rpx;
}

.sheet-custom-label {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--accent);
  margin-top: -28rpx;
  margin-bottom: 32rpx;
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sheet-label {
  font-size: 28rpx;
  color: var(--muted);
}

.sheet-stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-btn {
  padding: 10rpx 28rpx;
  background: var(--surface);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--fg);
}

.step-plus {
  background: var(--accent);
  color: #0a0a0a;
}

.step-value {
  font-size: 36rpx;
  font-weight: 700;
  min-width: 80rpx;
  text-align: center;
}

.step-input {
  width: 112rpx;
  height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
  background: var(--bg);
  color: var(--fg);
  font-size: 32rpx;
  font-weight: 700;
}

.step-input-reps {
  width: 88rpx;
}

.step-input-sets {
  width: 88rpx;
}

/* Rest duration options in start sheet */
.rest-options {
  display: flex;
  gap: 12rpx;
}

.rest-option {
  padding: 12rpx 24rpx;
  background: var(--surface);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.rest-option-active {
  background: var(--accent);
  color: #0a0a0a;
  font-weight: 600;
}

.btn-confirm {
  width: 100%;
  height: 96rpx;
  background: var(--accent);
  color: #0a0a0a;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 20rpx;
  border: none;
  margin-top: 20rpx;
}

.btn-confirm::after {
  border: none;
}

/* Delayed Confirm Button */
.btn-confirm-wrapper {
  position: relative;
  width: 100%;
  height: 96rpx;
  background: var(--surface);
  border: 2rpx solid var(--accent);
  border-radius: 20rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.btn-confirm-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: var(--accent);
  opacity: 0.2;
  transition: width 0.05s linear;
}

.btn-confirm-text {
  position: relative;
  z-index: 1;
  color: var(--accent);
  font-weight: 800;
  font-size: 34rpx;
}

/* ===== 宽屏适配(iPad / 折叠屏展开态) =====
   fixed 元素相对视口定位,不受 app.wxss 中 page 的 max-width 约束;
   这里把它们收进与内容同宽的居中窄栏(560px),遮罩保持全屏。 */
@media (min-width: 600px) {
  .sheet {
    left: calc(50% - 280px);
    right: calc(50% - 280px);
  }

  .floating-toast {
    left: calc(50% - 280px + 14px);
    right: calc(50% - 280px + 14px);
  }
}
