.container {
  min-height: 100vh;
  background: var(--bg);
}

/* ===== Common ===== */
.view-header {
  padding: 40rpx 28rpx 24rpx;
}

.view-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.view-desc {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

/* ===== Categories ===== */
.categories-view {
  padding: 0 28rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.category-card {
  width: calc(33.33% - 14rpx);
  padding: 36rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.category-icon {
  font-size: 56rpx;
}

.category-name {
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== Exercises ===== */
.exercises-view {
  padding: 0 28rpx;
}

.back-row {
  padding: 28rpx 0;
  font-size: 26rpx;
  color: var(--muted);
}

.back-arrow {
  margin-right: 10rpx;
}

.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.exercise-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.exercise-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.exercise-meta {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.exercise-arrow {
  font-size: 28rpx;
  color: var(--muted);
}

/* ===== Training ===== */
.training-view {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 28rpx;
}

.training-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.training-exercise {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.training-set-count {
  display: block;
  font-size: 26rpx;
  color: var(--accent);
  margin-top: 8rpx;
}

/* Set Dots */
.set-dots {
  display: flex;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--border);
  transition: all 0.2s ease;
}

.dot-done {
  background: var(--accent);
}

.dot-current {
  background: transparent;
  border: 3rpx solid var(--accent);
  width: 26rpx;
  height: 26rpx;
  margin-top: -3rpx;
}

/* Last Set */
.last-set-info {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  margin-bottom: 20rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(28, 28, 28, 0.96), rgba(20, 20, 20, 0.96));
  transition: all 0.2s ease;
}

.last-set-info-expanded {
  border-color: rgba(34, 197, 94, 0.35);
  box-shadow: 0 12rpx 38rpx rgba(0, 0, 0, 0.22);
}

.last-set-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.last-label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
}

.last-toggle {
  display: block;
  font-size: 22rpx;
  color: var(--accent);
  border: 1rpx solid rgba(34, 197, 94, 0.3);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

.last-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.last-detail {
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--border);
}

.last-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 14rpx;
}

.last-detail-label {
  font-size: 24rpx;
  color: var(--muted);
}

.last-detail-value {
  font-size: 26rpx;
  color: var(--fg);
  font-weight: 600;
}

.undo-btn {
  padding: 16rpx 40rpx;
  color: var(--danger);
  font-size: 24rpx;
  margin-bottom: 48rpx;
}

.rest-setting-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 40rpx;
}

.rest-setting-row-center {
  justify-content: center;
  margin-bottom: 32rpx;
}

.rest-setting-label {
  font-size: 24rpx;
  color: var(--muted);
}

.rest-setting-action {
  font-size: 24rpx;
  color: var(--accent);
  border: 1rpx solid rgba(34, 197, 94, 0.35);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

/* Big + Button */
.add-btn-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: auto;
  margin-bottom: 80rpx;
}

.add-btn {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, #86efac 0, var(--accent) 45%, #16a34a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 0 0 18rpx rgba(34, 197, 94, 0.08),
    0 20rpx 56rpx rgba(34, 197, 94, 0.35),
    0 0 80rpx rgba(34, 197, 94, 0.22);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.add-btn:active,
.add-btn-pressed {
  transform: scale(0.9);
  box-shadow:
    0 0 0 10rpx rgba(34, 197, 94, 0.12),
    0 10rpx 30rpx rgba(34, 197, 94, 0.36),
    0 0 48rpx rgba(34, 197, 94, 0.28);
}

.add-btn-text {
  font-size: 118rpx;
  color: #0a0a0a;
  font-weight: 300;
  line-height: 1;
}

.add-btn-label {
  display: block;
  font-size: 28rpx;
  color: var(--muted);
  margin-top: 30rpx;
}

/* ===== Resting ===== */
.resting-view {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 28rpx;
}

.rest-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.rest-exercise {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.rest-set-done {
  display: block;
  font-size: 26rpx;
  color: var(--accent);
  margin-top: 8rpx;
}

/* Timer Circle */
.rest-timer-circle {
  margin-bottom: 48rpx;
}

.timer-ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  padding: 10rpx;
  background: var(--border);
}

.timer-progress {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.timer-inner {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.timer-seconds {
  font-size: 80rpx;
  font-weight: 800;
  color: var(--accent);
}

.timer-unit {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.rest-last-set {
  text-align: center;
  margin-bottom: 20rpx;
}

.rest-set-weight {
  font-size: 40rpx;
  font-weight: 700;
}

.rest-set-reps {
  display: block;
  font-size: 28rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.warmup-tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  margin-top: 8rpx;
}

.rest-next {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 48rpx;
}

.rest-actions {
  margin-top: auto;
  margin-bottom: 40rpx;
}

.btn-skip-rest {
  background: transparent;
  border: 2rpx solid var(--border);
  color: var(--fg);
  font-size: 28rpx;
  padding: 24rpx 80rpx;
  border-radius: 20rpx;
}

.btn-skip-rest::after {
  border: none;
}

/* ===== Summary ===== */
.summary-view {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 28rpx 60rpx;
}

.summary-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #0a0a0a;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.summary-title {
  font-size: 48rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.summary-exercise {
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 48rpx;
}

.summary-stats {
  display: flex;
  gap: 60rpx;
  margin-bottom: 48rpx;
}

.summary-stat {
  text-align: center;
}

.s-val {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--accent);
}

.s-label {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.summary-sets {
  width: 100%;
  margin-bottom: 60rpx;
}

.summary-sets-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.summary-set-row {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: var(--surface);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.ss-num {
  font-size: 26rpx;
  color: var(--muted);
  width: 120rpx;
}

.ss-data {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
}

.ss-warmup {
  font-size: 20rpx;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.btn-finish {
  width: 100%;
  height: 96rpx;
  background: var(--accent);
  color: #0a0a0a;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 20rpx;
  border: none;
}

.btn-finish::after {
  border: none;
}

/* ===== Bottom Sheet ===== */
.sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface-elevated);
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 28rpx 48rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-open {
  transform: translateY(0);
}

.sheet-handle {
  width: 56rpx;
  height: 6rpx;
  background: var(--border);
  border-radius: 3rpx;
  margin: 0 auto 32rpx;
}

.sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 36rpx;
}

.start-subtitle {
  display: block;
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
  margin-top: -22rpx;
  margin-bottom: 36rpx;
}

.start-step-value,
.start-picker-value {
  display: block;
  min-width: 116rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  background: var(--bg);
  border: 2rpx solid var(--border);
  color: var(--fg);
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.start-picker-value {
  min-width: 150rpx;
  color: var(--accent);
}

.btn-start-training {
  width: 100%;
  height: 96rpx;
  background: var(--accent);
  color: #0a0a0a;
  font-size: 32rpx;
  font-weight: 800;
  border-radius: 20rpx;
  border: none;
  margin-top: 20rpx;
}

.btn-start-training::after {
  border: none;
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sheet-label {
  font-size: 28rpx;
  color: var(--muted);
}

.sheet-stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step-btn {
  min-width: 128rpx;
  padding: 18rpx 18rpx;
  background: var(--surface);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--fg);
  text-align: center;
}

.step-plus {
  background: var(--accent);
  color: #0a0a0a;
}

.step-input {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  width: 120rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: var(--bg);
  border: 2rpx solid var(--border);
  color: var(--fg);
  text-align: center;
  box-sizing: border-box;
}

.step-input-reps {
  width: 96rpx;
}

.btn-confirm {
  width: 100%;
  height: 96rpx;
  background: var(--accent);
  color: #0a0a0a;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 20rpx;
  border: none;
  margin-top: 20rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(34, 197, 94, 0.18);
}

.btn-confirm::after {
  border: none;
}

.btn-confirm-holding {
  transform: scale(0.99);
}

.confirm-progress {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.34);
  transition: width 0.05s linear;
}

.confirm-text {
  position: relative;
  z-index: 1;
  font-weight: 900;
  letter-spacing: 1rpx;
  transition: font-size 0.08s ease, transform 0.08s ease;
}

.undo-toast,
.rest-finished-hint,
.missed-prompt {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  z-index: 120;
}

.undo-toast {
  top: 28rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.28);
}

.undo-title,
.undo-desc,
.missed-title,
.missed-desc {
  display: block;
}

.undo-title {
  color: var(--fg);
  font-size: 28rpx;
  font-weight: 700;
}

.undo-desc {
  color: var(--muted);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.undo-action {
  margin: 0;
  min-width: 112rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: rgba(239, 68, 68, 0.12);
  color: var(--danger);
  font-size: 26rpx;
  border: 1rpx solid rgba(239, 68, 68, 0.3);
}

.undo-action::after,
.missed-btn::after {
  border: none;
}

.rest-finished-hint {
  top: 28rpx;
  padding: 24rpx;
  color: var(--accent);
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
}

.missed-prompt {
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  padding: 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, 0.34);
}

.missed-title {
  font-size: 30rpx;
  font-weight: 800;
}

.missed-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.missed-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.missed-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  background: var(--surface);
  color: var(--fg);
  font-size: 26rpx;
  border: 1rpx solid var(--border);
}

.missed-primary {
  background: var(--accent);
  color: #0a0a0a;
  border: none;
  font-weight: 700;
}
